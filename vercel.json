{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.pethealthos.online" }],
      "destination": "https://pethealthos.online/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/health-watch",
      "schedule": "30 8 * * *"
    }
  ]
}
