# --- Database (required) ---
# PostgreSQL connection string. Locally you can point this at a Neon branch.
# On Vercel, add the Neon (Postgres) integration and this is injected automatically.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# --- AI (optional) ---
# Without a key the app runs in "demo mode" with rule-based fallbacks.
# Option A (used here): Google Gemini directly.
GOOGLE_GENERATIVE_AI_API_KEY=""
# Gemini model (default: gemini-2.5-flash)
GOOGLE_AI_MODEL="gemini-2.5-flash"
# Option B: Vercel AI Gateway "provider/model" strings.
AI_GATEWAY_API_KEY=""
AI_MODEL="openai/gpt-4o-mini"

# --- Auth (required in production) ---
# Secret used to sign session cookies for buyer accounts. Use a long random value.
AUTH_SECRET=""

# --- Reminder notifications cron (recommended) ---
# Protects /api/cron/reminders. Vercel sends this as a Bearer token to cron runs.
CRON_SECRET=""

# --- Email delivery for reminders + admin pings (optional) ---
# If unset, reminders are in-app only. With a Resend key, owners get emails too,
# and the review team is pinged on new shop verification submissions.
RESEND_API_KEY=""
RESEND_FROM="PawSure <onboarding@resend.dev>"

# --- Shop verification / admin review ---
# ADMIN_PASSWORD: shared password to open the /admin review queue (required to
# access /admin until per-person team accounts exist).
ADMIN_PASSWORD=""
# ADMIN_EMAILS: optional comma-separated list of reviewer emails. A logged-in
# user with one of these emails is treated as an admin, and these addresses
# receive the new-submission notification emails.
ADMIN_EMAILS=""

# --- File uploads (optional, required for uploads in production) ---
# On Vercel the filesystem is read-only, so uploads use Vercel Blob.
# Add a Blob store in Vercel and this token is injected automatically.
# Locally, leave empty to fall back to writing into public/uploads.
BLOB_READ_WRITE_TOKEN=""

# --- Payments (optional, required to take real money) ---
# Card checkout via Stripe HK. WeChat/Alipay are deferred until incorporation —
# see docs/PAYMENTS_WALLETS_DEFERRED.md for the revisit plan.
STRIPE_SECRET_KEY=""
# Webhook signing secret from `stripe listen` (local) or Stripe Dashboard → Webhooks
# (production endpoint: /api/stripe/webhook). Events: checkout.session.completed,
# checkout.session.async_payment_succeeded, customer.subscription.deleted,
# charge.refunded (owner slot refunds).
# Also enable Stripe Customer Portal (Dashboard → Settings → Billing → Customer portal)
# so /me/account and /app/account can open subscription management.
STRIPE_WEBHOOK_SECRET=""

# --- Phone / SMS OTP (optional; the Phone auth tab is currently greyed out) ---
# Provider-agnostic; Twilio shown as an example. Until these are set, phone
# login/registration stays disabled in the UI.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""

# --- China access / Hong Kong reverse proxy (optional) ---
# Canonical public URL for Stripe Checkout return links (success/cancel). Set to
# your HK proxy domain so mainland users are not redirected to *.vercel.app after
# payment (often blocked without a VPN). Example: https://pethealthos.online
APP_PUBLIC_URL=""
# When the app runs behind the HK Caddy proxy on a custom domain, Server Actions
# must accept that origin. pethealthos.online + www are already built into
# next.config.ts; add extra hosts here (comma-separated, host only, no scheme)
# without a code change — useful if the brand/domain changes.
PROXY_ALLOWED_ORIGINS=""
# Set to "0" to disable the same-origin blob image proxy (/api/img) — e.g. if a
# CDN later fronts the Vercel Blob store. Default (unset) = proxy enabled.
NEXT_PUBLIC_IMG_PROXY=""
