// Pet Health OS — data model
// One database, strict per-pet logical scoping.
// Enum-like fields are Strings validated in app code (see src/lib/constants.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  kind      String   @default("SHOP") // SHOP | BREEDER | SHELTER
  createdAt DateTime @default(now())

  // Billing — plan key (see src/lib/plans.ts). extraPetSlots = paid overage
  // capacity purchased on top of the plan's included pets.
  plan          String @default("STARTER") // STARTER | SHOP
  extraPetSlots Int    @default(0)

  pets          Pet[]
  notifications Notification[]
}

// Consumer account — created when a buyer claims a passport or self-registers.
// Auth is via email+password and/or phone (OTP); either identifier may be null.
model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  phone        String?  @unique
  name         String
  passwordHash String?
  createdAt    DateTime @default(now())

  plan          String @default("FREE") // FREE | PLUS
  extraPetSlots Int    @default(0)

  pets          Pet[]          @relation("OwnerUser")
  claims        Transfer[]
  notifications Notification[]
}

// Short-lived phone verification codes for SMS OTP sign-in / registration.
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Pet {
  id        String    @id @default(cuid())
  // Null for consumer self-added pets (no breeder org). Breeder-managed pets
  // always belong to an organization.
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  species   String    // DOG | CAT
  breed     String?
  sex       String?   // MALE | FEMALE | UNKNOWN
  birthDate DateTime?
  weightKg  Float?
  color     String?
  microchip String?
  photoUrl  String?
  status    String    @default("ACTIVE") // ACTIVE | UNDER_OBSERVATION | TRANSFERRED | ARCHIVED
  intakeAt  DateTime  @default(now())
  notes     String?

  // Consumer owner once a buyer claims the passport. The pet stays in the
  // breeder org (their read-only copy); the owner continues the timeline.
  ownerUserId String?
  ownerUser   User?    @relation("OwnerUser", fields: [ownerUserId], references: [id])

  // Basic lineage (breeder MVP) — full litter management is Phase 2.
  sireId    String?
  sire      Pet?      @relation("Sire", fields: [sireId], references: [id])
  sireOf    Pet[]     @relation("Sire")
  damId     String?
  dam       Pet?      @relation("Dam", fields: [damId], references: [id])
  damOf     Pet[]     @relation("Dam")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  logs          LogEntry[]
  reminders     Reminder[]
  conversations Conversation[]
  reports       TriageReport[]
  transfers     Transfer[]
  attachments   Attachment[]
  weights       WeightEntry[]
  notifications Notification[]

  @@index([orgId])
  @@index([ownerUserId])
}

// Per-pet weight tracking — the daily-use ritual for breeders (neonate/growth
// weights). Litter grouping is deferred; this is individual-pet only for now.
model WeightEntry {
  id         String   @id @default(cuid())
  petId      String
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  weightKg   Float
  measuredAt DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())

  @@index([petId, measuredAt])
}

model Attachment {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  kind      String   @default("OTHER") // VACCINE_CERT | PEDIGREE | LAB_RESULT | PHOTO | OTHER
  label     String
  url       String
  mimeType  String?
  createdAt DateTime @default(now())

  @@index([petId])
}

model LogEntry {
  id         String   @id @default(cuid())
  petId      String
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())
  rawText    String   // the user's freeform entry

  // AI-structured fields (hybrid logging)
  type       String   @default("OBSERVATION") // ILLNESS | VET_VISIT | OBSERVATION | MEDICATION | DISCOMFORT | MILESTONE | FEEDING | OTHER
  severity   String   @default("NONE")        // NONE | LOW | MEDIUM | HIGH | CRITICAL
  title      String?
  summary    String?
  tags       String   @default("[]")          // JSON array of strings
  structured String?                          // JSON blob of extracted fields (symptoms, vitals, meds...)
  aiProcessed Boolean @default(false)

  // Credibility: once a passport is issued, the pre-transfer history is frozen
  // so it can't be retroactively edited/backdated. lockedAt marks that freeze.
  lockedAt   DateTime?

  createdAt  DateTime @default(now())

  @@index([petId, occurredAt])
}

model Reminder {
  id        String    @id @default(cuid())
  petId     String
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  title     String
  category  String    @default("OTHER") // VACCINE | MEDICATION | DEWORMING | APPOINTMENT | CHECKUP | OTHER
  dueAt     DateTime
  recurrence String?  // null | DAILY | WEEKLY | MONTHLY | YEARLY
  completed Boolean   @default(false)
  notes     String?

  createdAt DateTime  @default(now())

  @@index([petId, dueAt])
}

model Conversation {
  id        String    @id @default(cuid())
  petId     String
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]

  @@index([petId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      String   // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model TriageReport {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  urgency   String   @default("ROUTINE") // EMERGENCY | URGENT | SOON | ROUTINE | MONITOR
  summary   String
  content   String   // JSON: { concerns, recommendation, vetQuestions, vitalsTrend, relevantLogIds }
  createdAt DateTime @default(now())

  @@index([petId, createdAt])
}

model Transfer {
  id            String    @id @default(cuid())
  petId         String
  pet           Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  token         String    @unique
  newOwnerName  String?
  newOwnerEmail String?
  note          String?
  visibility    String    @default("READONLY_COPY") // READONLY_COPY | SHARED

  // Breeder controls whether the buyer may claim & continue the record. If
  // false, the passport stays view-only/locked.
  claimable     Boolean   @default(false)

  createdAt     DateTime  @default(now())
  firstViewedAt DateTime? // first time the buyer opened the passport
  claimedAt     DateTime? // set only when the buyer actually claims it
  claimedByName String?

  // The consumer account that claimed this passport.
  claimedByUserId String?
  claimedByUser   User?   @relation(fields: [claimedByUserId], references: [id])

  @@index([petId])
}

// In-app notification (e.g. a reminder coming due). Recipient is exactly one of
// a breeder org or a consumer user. Email delivery is layered on top via cron
// when an email provider key is configured.
model Notification {
  id     String @id @default(cuid())
  petId  String
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  orgId  String?
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String?
  user   User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  reminderId String?
  kind       String    @default("REMINDER") // REMINDER | CLAIM | SYSTEM
  title      String
  body       String?
  dueAt      DateTime?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId, readAt])
  @@index([userId, readAt])
  @@index([reminderId])
}
