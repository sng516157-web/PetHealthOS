// Pet Health OS — data model
// One database, strict per-pet logical scoping.
// Enum-like fields are Strings validated in app code (see src/lib/constants.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id        String   @id @default(cuid())
  // SHOP | BREEDER | SHELTER own pets and may issue passports (if verified).
  // HOSPITAL | BOARDING are "facility" accounts: they don't own pets — they get
  // time-boxed access to owner-owned pets via PetStay, and can't issue passports.
  name      String
  kind      String   @default("SHOP")
  createdAt DateTime @default(now())

  // Billing — plan key (see src/lib/plans.ts). extraPetSlots = paid overage
  // capacity purchased on top of the plan's included pets.
  plan          String @default("STARTER") // STARTER | SHOP
  extraPetSlots Int    @default(0)
  // How the paid SHOP plan was purchased: month | year | lifetime (null on the
  // free STARTER tier). planActivatedAt is when it was last (re)activated.
  planInterval    String?
  planActivatedAt DateTime?
  // Set false permanently when the org subscribes to monthly/yearly SHOP (founding lifetime forfeited).
  foundingBreederEligible Boolean @default(true)
  // Stripe Customer for card subscriptions (portal cancel / renew).
  stripeCustomerId String?

  // Referral programme (deferred — see docs/REFERRALS_DEFERRED.md). Columns unused.
  referralCode String? @unique
  referredById String?
  referredBy   Organization?  @relation("Referrals", fields: [referredById], references: [id])
  referrals    Organization[] @relation("Referrals")

  // Shop verification (KYC). A shop must upload a business licence (营业执照) or
  // alternative proof and be approved by the PawSure team before it can issue
  // health passports. Until then it can sign up and set up freely.
  verificationStatus      String    @default("UNVERIFIED") // UNVERIFIED | PENDING | APPROVED | REJECTED
  verificationDocUrl      String?   // private Blob URL / local path of the proof
  verificationDocType     String?   // LICENSE | ALT
  verificationNote        String?   // applicant's note (business name, context)
  reviewNote              String?   // reviewer's reason (esp. on rejection)
  verificationSubmittedAt DateTime?
  verificationReviewedAt  DateTime?

  pets          Pet[]
  members       User[] @relation("OrgMembers")
  notifications Notification[]
  stays         PetStay[] @relation("FacilityStays")
  orgSlots           OrgSlot[]
  dataImportRequests DataImportRequest[]
  vaccineTemplates   VaccineScheduleTemplate[]
}

// Purchased org capacity — shop extra pets (shop_pet) or facility care slots (care).
model OrgSlot {
  id         String    @id @default(cuid())
  orgId      String
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  kind       String    // care | shop_pet
  petId      String?   @unique
  pet        Pet?      @relation(fields: [petId], references: [id], onDelete: SetNull)
  petStayId  String?   @unique
  petStay    PetStay?  @relation(fields: [petStayId], references: [id], onDelete: SetNull)
  status     String    @default("ACTIVE") // ACTIVE | PENDING | REVOKED
  comped     Boolean   @default(false) // admin grant — not revoked by Stripe sync
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  @@index([orgId, kind, status])
}

// Consumer account — created when a buyer claims a passport or self-registers.
// Auth is via email+password and/or phone (OTP); either identifier may be null.
model User {
  id           String   @id @default(cuid())
  email            String?   @unique
  phone            String?   @unique
  name             String
  passwordHash     String?
  emailVerifiedAt  DateTime?
  termsAcceptedAt  DateTime?
  privacyAcceptedAt DateTime?
  createdAt        DateTime  @default(now())

  plan          String @default("FREE") // FREE | PLUS
  extraPetSlots Int    @default(0) // legacy — no longer used for owner billing
  planInterval    String?
  planActivatedAt DateTime?
  stripeCustomerId String?

  // Single-device enforcement for owner accounts: the active session id (also
  // embedded in the signed cookie) + its expiry. When a newer login replaces
  // it, older devices stop matching and are logged out. Shops are multi-device
  // and leave these null.
  sessionId        String?
  sessionExpiresAt DateTime?

  // Unified auth: a user with an org is a "shop" account (breeder/shop/shelter
  // workspace at /app). A user without an org is an "owner" account (/me).
  orgId String?
  org   Organization? @relation("OrgMembers", fields: [orgId], references: [id], onDelete: SetNull)

  pets               Pet[]               @relation("OwnerUser")
  ownerPetSlots      OwnerPetSlot[]
  deathClaims        PetDeathClaim[]
  claims             Transfer[]
  notifications      Notification[]
  emailVerifications EmailVerification[]
  passwordResets     PasswordReset[]
  dataImportRequests DataImportRequest[]

  @@index([orgId])
}

// Magic-link tokens for email verification on register / sign-in.
model EmailVerification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String
  codeHash   String?   // HMAC of 6-digit code (optional on legacy rows)
  codeAttempts Int     @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

// Password reset tokens — magic link + 6-digit code, 1-hour TTL.
model PasswordReset {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String
  codeHash     String?
  codeAttempts Int       @default(0)
  expiresAt    DateTime
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt])
}

// A purchased extra-pet capacity slot for an owner. Linked to a pet once used;
// REVOKED when the Stripe subscription ends or a refund is issued — the pet
// stays viewable but loses AI + new logging.
model OwnerPetSlot {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  petId                String?   @unique
  pet                  Pet?      @relation(fields: [petId], references: [id], onDelete: SetNull)
  status               String    @default("ACTIVE") // ACTIVE | PENDING | REVOKED
  comped               Boolean   @default(false) // admin grant — not revoked by Stripe sync
  stripeSubscriptionId String?
  createdAt            DateTime  @default(now())
  revokedAt            DateTime?

  @@index([userId, status])
}

// Short-lived phone verification codes for SMS OTP sign-in / registration.
model PhoneOtp {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}

model Pet {
  id        String    @id @default(cuid())
  // Null for consumer self-added pets (no breeder org). Breeder-managed pets
  // always belong to an organization.
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)

  name      String
  species   String    // DOG | CAT
  breed     String?
  sex       String?   // MALE | FEMALE | UNKNOWN
  birthDate DateTime?
  weightKg  Float?
  color     String?
  microchip String?
  photoUrl  String?
  status    String    @default("ACTIVE") // ACTIVE | UNDER_OBSERVATION | TRANSFERRED | ARCHIVED
  // When the pet entered this shop/breeder's care (optional if birth date is known).
  intakeAt  DateTime?
  notes     String?

  // QR check-in token for facilities (hospital/boarding). The owner shows the QR
  // encoding this token; a facility scans it to admit the pet (PetStay). Rotated
  // when the owner confirms takeback, so an old QR can't silently re-admit.
  stayToken String?  @unique

  // Consumer owner once a buyer claims the passport. The pet stays in the
  // breeder org (their read-only copy); the owner continues the timeline.
  ownerUserId String?
  ownerUser   User?    @relation("OwnerUser", fields: [ownerUserId], references: [id])

  // Optional litter label for breeder bulk ops (filter + bulk log).
  litterName String?
  // View-only buyer preview before passport issue (/preview/[token]).
  previewToken String? @unique

  // Basic lineage (breeder MVP) — full litter management is Phase 2.
  sireId    String?
  sire      Pet?      @relation("Sire", fields: [sireId], references: [id])
  sireOf    Pet[]     @relation("Sire")
  damId     String?
  dam       Pet?      @relation("Dam", fields: [damId], references: [id])
  damOf     Pet[]     @relation("Dam")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  // Set when the owner archives a pet after passing (read-only memorial).
  deceasedAt DateTime?

  logs            LogEntry[]
  foodLogs        FoodLogEntry[]
  activityLogs    ActivityLogEntry[]
  medicationLogs  MedicationLogEntry[]
  reminders     Reminder[]
  conversations Conversation[]
  reports       TriageReport[]
  transfers     Transfer[]
  attachments   Attachment[]
  weights       WeightEntry[]
  notifications Notification[]
  stays         PetStay[]
  ownerSlot     OwnerPetSlot?
  orgSlot       OrgSlot?
  deathClaim    PetDeathClaim?

  @@index([orgId])
  @@index([ownerUserId])
}

// A pet's stay at a facility (hospital/boarding). One row per (pet, facility);
// re-admitting/taking-back toggles status. While ACTIVE the facility sees the
// pet's full current history; once ARCHIVED (owner confirmed takeback) the
// facility only sees history up to releasedAt — no further owner updates leak.
model PetStay {
  id         String    @id @default(cuid())
  petId      String
  pet        Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  orgId      String
  org        Organization @relation("FacilityStays", fields: [orgId], references: [id], onDelete: Cascade)

  status     String    @default("ACTIVE") // ACTIVE | ARCHIVED
  admittedAt DateTime  @default(now())
  releasedAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  orgSlot    OrgSlot?

  @@unique([petId, orgId])
  @@index([orgId])
  @@index([petId])
}

// Org-level vaccine schedule templates — breeders apply to a pet or whole litter.
model VaccineScheduleTemplate {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  species   String?  // DOG | CAT | null = both
  items     Json     // [{ label, category, daysAfterAnchor, note? }]
  createdAt DateTime @default(now())

  @@index([orgId])
}

// Per-pet weight tracking — the daily-use ritual for breeders (neonate/growth
// weights). Litter grouping is deferred; this is individual-pet only for now.
model WeightEntry {
  id         String   @id @default(cuid())
  petId      String
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  weightKg   Float
  measuredAt DateTime @default(now())
  note       String?
  createdAt  DateTime @default(now())

  @@index([petId, measuredAt])
}

model Attachment {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  kind      String   @default("OTHER") // VACCINE_CERT | PEDIGREE | LAB_RESULT | PHOTO | OTHER
  label     String
  url       String
  mimeType  String?
  createdAt DateTime @default(now())

  @@index([petId])
}

model LogEntry {
  id         String   @id @default(cuid())
  petId      String
  pet        Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  occurredAt DateTime @default(now())
  rawText    String   // the user's freeform entry

  // Optional photo/video attached to the entry. Images are analysed by the AI
  // (visual triage); videos are stored & shown but not analysed yet.
  imageUrl   String?
  imageMime  String?

  // AI-structured fields (hybrid logging)
  type       String   @default("OBSERVATION") // ILLNESS | VET_VISIT | OBSERVATION | MEDICATION | DISCOMFORT | MILESTONE | FEEDING | OTHER
  severity   String   @default("NONE")        // NONE | LOW | MEDIUM | HIGH | CRITICAL
  title      String?
  summary    String?
  tags       String   @default("[]")          // JSON array of strings
  structured String?                          // JSON blob of extracted fields (symptoms, vitals, meds...)
  aiProcessed Boolean @default(false)

  // Credibility: once a passport is issued, the pre-transfer history is frozen
  // so it can't be retroactively edited/backdated. lockedAt marks that freeze.
  lockedAt   DateTime?

  // When a facility (hospital/boarding) adds the entry during a stay, we tag it
  // so the owner can see who recorded it ("Logged by: <facility>"). Null for the
  // owner's / shop's own entries.
  loggedByOrgId String?
  loggedByName  String?

  createdAt  DateTime @default(now())

  @@index([petId, occurredAt])
}

model FoodLogEntry {
  id            String    @id @default(cuid())
  petId         String
  pet           Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  occurredAt    DateTime  @default(now())
  mealType      String    // BREAKFAST | LUNCH | DINNER | SNACK | TREAT | OTHER
  foodName      String?
  amount        String?
  appetite      String?   // NORMAL | INCREASED | DECREASED | REFUSED
  notes         String?
  lockedAt      DateTime?
  loggedByOrgId String?
  loggedByName  String?
  createdAt     DateTime  @default(now())

  @@index([petId, occurredAt])
}

model ActivityLogEntry {
  id            String    @id @default(cuid())
  petId         String
  pet           Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  occurredAt    DateTime  @default(now())
  activityType  String    // WALK | RUN | PLAY | TRAINING | PARK | OTHER
  durationMin   Int?
  distanceKm    Float?
  intensity     String?   // LIGHT | MODERATE | VIGOROUS
  notes         String?
  lockedAt      DateTime?
  loggedByOrgId String?
  loggedByName  String?
  createdAt     DateTime  @default(now())

  @@index([petId, occurredAt])
}

model MedicationLogEntry {
  id             String    @id @default(cuid())
  petId          String
  pet            Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  occurredAt     DateTime  @default(now())
  medicationName String
  dose           String?
  route          String?   // ORAL | TOPICAL | INJECTION | OTHER
  notes          String?
  lockedAt       DateTime?
  loggedByOrgId  String?
  loggedByName   String?
  createdAt      DateTime  @default(now())

  @@index([petId, occurredAt])
}

model Reminder {
  id        String    @id @default(cuid())
  petId     String
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  title     String
  category  String    @default("OTHER") // VACCINE | MEDICATION | DEWORMING | APPOINTMENT | CHECKUP | OTHER
  dueAt     DateTime
  recurrence String?  // null | DAILY | WEEKLY | MONTHLY | YEARLY
  completed Boolean   @default(false)
  notes     String?

  createdAt DateTime  @default(now())

  @@index([petId, dueAt])
}

model Conversation {
  id        String    @id @default(cuid())
  petId     String
  pet       Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  title     String    @default("New conversation")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  messages  Message[]

  @@index([petId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role      String   // user | assistant
  content   String
  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model TriageReport {
  id        String   @id @default(cuid())
  petId     String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)

  urgency   String   @default("ROUTINE") // EMERGENCY | URGENT | SOON | ROUTINE | MONITOR
  summary   String
  content   String   // JSON: { concerns, recommendation, vetQuestions, vitalsTrend, relevantLogIds }
  createdAt DateTime @default(now())

  @@index([petId, createdAt])
}

model Transfer {
  id            String    @id @default(cuid())
  petId         String
  pet           Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)

  token         String    @unique
  newOwnerName  String?
  newOwnerEmail String?
  note          String?
  visibility    String    @default("READONLY_COPY") // READONLY_COPY | SHARED

  // Health guarantee baked into the passport — the breeder's warranty, frozen at
  // issue so it's a tamper-evident contract both sides can rely on.
  guaranteeType  String    @default("NONE") // NONE | D7 | D30 | CONGENITAL_1Y | CUSTOM
  guaranteeDays  Int?      // window length in days from handover; null = no expiry/none
  guaranteeTerms String?   // what's covered / conditions
  vetCheckedAt   DateTime? // date of the pre-handover vet health check
  vetCheckNote   String?   // what the vet check found

  // Breeder controls whether the buyer may claim & continue the record. If
  // false, the passport stays view-only/locked.
  claimable     Boolean   @default(false)

  createdAt     DateTime  @default(now())
  firstViewedAt DateTime? // first time the buyer opened the passport
  claimedAt     DateTime? // set only when the buyer actually claims it
  claimedByName String?

  // The consumer account that claimed this passport.
  claimedByUserId String?
  claimedByUser   User?   @relation(fields: [claimedByUserId], references: [id])

  @@index([petId])
}

// Owner-submitted proof when archiving a pet after passing. Admin review unlocks
// a 3-month condolence billing credit when approved.
model PetDeathClaim {
  id              String    @id @default(cuid())
  petId           String    @unique
  pet             Pet       @relation(fields: [petId], references: [id], onDelete: Cascade)
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  proofDocUrls    String    // JSON string[] of private doc refs (min 2 on submit)
  applicantNote   String?
  reviewNote      String?
  refundMonths    Int       @default(3)
  submittedAt     DateTime  @default(now())
  reviewedAt      DateTime?
  refundGrantedAt DateTime?

  @@index([status, submittedAt])
  @@index([userId])
}

// User-submitted bulk import (CSV roster + PDF/scanned records). Processed by the
// team until automated AI import ships; files stored as private doc refs.
model DataImportRequest {
  id          String    @id @default(cuid())
  status      String    @default("PENDING") // PENDING | COMPLETED
  orgId       String?
  org         Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileRefs    String    // JSON string[] — private doc refs (csv first, then pdfs)
  fileNames   String    // JSON string[] — parallel original filenames
  note        String?
  adminNote   String?
  /** JSON `DataImportProcessingState` — column map, row/doc assignments, audit trail (AI-ready). */
  processingState String?
  submittedAt DateTime  @default(now())
  completedAt DateTime?

  @@index([status, submittedAt])
  @@index([orgId])
  @@index([userId])
}

// In-app notification (e.g. a reminder coming due). Recipient is exactly one of
// a breeder org or a consumer user. Email delivery is layered on top via cron
// when an email provider key is configured.
model Notification {
  id     String @id @default(cuid())
  petId  String
  pet    Pet    @relation(fields: [petId], references: [id], onDelete: Cascade)

  orgId  String?
  org    Organization? @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId String?
  user   User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  reminderId String?
  kind       String    @default("REMINDER") // REMINDER | CLAIM | SYSTEM
  title      String
  body       String?
  dueAt      DateTime?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId, readAt])
  @@index([userId, readAt])
  @@index([reminderId])
}
